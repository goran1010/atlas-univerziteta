# Webapp environment example
# Copy this file to `.env` and adjust values for your local setup.
# `.env` files are gitignored and should stay local.

# API
VITE_SERVER_URL=http://localhost:3000

# In production (Netlify), set VITE_SERVER_URL=/server
# The /server/* proxy in netlify.toml forwards requests to the actual server,
# keeping session cookies first-party and avoiding third-party cookie restrictions.

# Absolute API base URL displayed on the /api-docs page for external consumers.
# Falls back to VITE_SERVER_URL when unset (fine for local development).
# In production (Netlify), set VITE_PUBLIC_API_URL=https://round-leann-goran-jovic-1010-ccad2ae8.koyeb.app
VITE_PUBLIC_API_URL=http://localhost:3000

# Absolute site URL used for canonical links and Open Graph meta tags.
# Falls back to https://uniatlas-bosnia.netlify.app when unset.
# VITE_SITE_URL=https://uniatlas-bosnia.netlify.app
