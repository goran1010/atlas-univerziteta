# Webapp environment example
# Copy this file to `.env` and adjust values for your local setup.
# `.env` files are gitignored and should stay local.

# API
VITE_API_URL=http://localhost:3000

# In production (Netlify), set VITE_API_URL=https://api.atlasuniverziteta.com
# The webapp calls the API directly - the apex and the api subdomain are
# same-site, so session cookies flow without a proxy.

# Absolute API base URL displayed on the /api-docs page for external consumers.
# Falls back to VITE_API_URL when unset (fine for local development).
# In production (Netlify), set VITE_PUBLIC_API_URL=https://api.atlasuniverziteta.com
VITE_PUBLIC_API_URL=http://localhost:3000

# Absolute site URL used for canonical links and Open Graph meta tags.
# Falls back to https://atlasuniverziteta.com when unset.
# VITE_SITE_URL=https://atlasuniverziteta.com
