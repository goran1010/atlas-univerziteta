{
  "name": "atlas-univerziteta-backend",
  "version": "1.0.0",
  "keywords": [],
  "author": "Goran Jović",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "npm run db:generate && tsc --build tsconfig.build.json",
    "db:migrate": "npx prisma migrate dev --name",
    "db:reset": "npx prisma migrate reset",
    "db:setup": "npx prisma migrate deploy && npx prisma generate",
    "db:generate": "npx prisma generate",
    "db:seed": "npx prisma db seed",
    "db:refold": "tsx --env-file-if-exists=.env src/db/refold.ts",
    "db:studio": "npx prisma studio",
    "test": "NODE_ENV=test vitest",
    "test:unit": "NODE_ENV=test vitest run --project unit",
    "test:integration": "NODE_ENV=test vitest run --project integration",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts | pino-pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.7.5",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
