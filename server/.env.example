# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/atlas-univerziteta
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/test_atlas-univerziteta

# Email Service Configuration (Resend)
RESEND_API_KEY=replace-with-resend-api-key
# Sender address for confirmation emails. Defaults to "onboarding@resend.dev"
# (Resend's shared test domain, can only deliver to the account owner's email).
# Set to a verified custom domain address for production (e.g. noreply@atlasuniverziteta.com).
# RESEND_FROM_EMAIL=noreply@atlasuniverziteta.com

# Application Configuration
WEBAPP_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
PORT=3000
COOKIE_SECRET=replace-with-cookie-secret

# BetterAuth (generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-better-auth-secret

NODE_ENV=development

# GitHub OAuth
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret