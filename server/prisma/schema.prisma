generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum role {
  ADMIN
  USER
}

model user {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  role             role      @default(USER)
  adminRequestedAt DateTime?

  // why the user wants admin access, cleared when the request is resolved
  adminRequestReason String?
  sessions           session[]
  accounts           account[]
  pendingChanges     PendingChange[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id])
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

enum typeOfChange {
  UPDATE
  DELETE
  CREATE
}

enum entity {
  FBIH
  RS
  BD
}

enum ownership {
  PUBLIC
  PRIVATE
}

enum studyCycle {
  FIRST
  SECOND
  THIRD
  INTEGRATED
  VOCATIONAL
  SPECIALIST
}

// The search* columns hold diacritic-folded lowercase copies of their source
// fields, set by writers via foldSearchText (pendingChangeInputs.ts, seed.ts).
// @default("") keeps them out of required create inputs; a row written
// without them simply cannot be found through search.
model University {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  searchName        String    @default("")
  acronym           String?
  searchAcronym     String?
  city              String
  searchCity        String    @default("")
  entity            entity
  ownership         ownership
  foundedYear       String?
  website           String?
  address           String?
  phone             String?
  email             String?
  accreditationFrom DateTime?
  accreditationTo   DateTime?
  authority         String?
  dataSourceUrl     String?
  lastModified      DateTime?
  faculties         Faculty[]

  @@unique([name, city])
  @@map("university")
}

model Faculty {
  id                Int            @id @default(autoincrement())
  name              String
  searchName        String         @default("")
  universityId      Int
  university        University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  city              String?
  searchCity        String?
  website           String?
  address           String?
  phone             String?
  email             String?
  isUniversityLevel Boolean        @default(false)
  dataSourceUrl     String?
  lastModified      DateTime?
  studyPrograms     StudyProgram[]

  // the unique above starts with name, so FK lookups need their own index
  @@unique([name, universityId])
  @@index([universityId])
  @@map("faculty")
}

model StudyProgram {
  id             Int        @id @default(autoincrement())
  name           String
  searchName     String     @default("")
  facultyId      Int
  faculty        Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  cycle          studyCycle
  durationYears  Int?
  ects           Int?
  language       String?
  searchLanguage String?
  dataSourceUrl  String?
  lastModified   DateTime?
  tracks         Track[]

  @@unique([name, facultyId, cycle])
  @@index([facultyId])
  @@map("study_program")
}

model Track {
  id             Int          @id @default(autoincrement())
  name           String
  searchName     String       @default("")
  studyProgramId Int
  studyProgram   StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  ects           Int?
  durationYears  Int?
  dataSourceUrl  String?
  lastModified   DateTime?

  @@unique([name, studyProgramId])
  @@index([studyProgramId])
  @@map("track")
}

enum targetType {
  UNIVERSITY
  FACULTY
  STUDY_PROGRAM
  TRACK
}

model PendingChange {
  id           String       @id @default(uuid())
  targetType   targetType
  typeOfChange typeOfChange

  // UPDATE or DELETE target
  targetId Int?

  // CREATE child parent
  // FACULTY -> universityId
  // STUDY_PROGRAM -> facultyId
  // TRACK -> studyProgramId
  parentId Int?

  // proposed data
  data Json?

  // contributor's note to the reviewing admin
  comment String?

  user       user      @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([createdAt])
  @@index([targetType, typeOfChange])
  @@index([targetId])
  @@index([parentId])
  @@index([userId])
  @@map("pending_change")
}
