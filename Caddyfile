# Caddy reverse-proxies API traffic to the Node.js server container.
# The webapp is hosted on Netlify separately - Caddy only handles the API.
# Automatic HTTPS via Let's Encrypt for the API subdomain.
# No access log: the server logs each request itself, with tokens removed.
# Caddy still logs its own errors, such as a 502 while the server is down.
{$DOMAIN} {
	reverse_proxy server:3000
}
