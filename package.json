{
  "name": "uniatlas-bosnia",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../webapp && npm install",
    "db:migrate_dev": "cd server && npm run db:migrate_dev",
    "db:reset": "cd server && npm run db:reset",
    "db:deploy_generate": "cd server && npm run db:deploy_generate",
    "db:generate": "cd server && npm run db:generate",
    "db:seed": "cd server && npm run db:seed",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:webapp\"",
    "dev:server": "cd server && npm run dev",
    "dev:webapp": "cd webapp && npm run dev",
    "test:all": "npm run test:server -- run && npm run test:webapp -- run",
    "test:server": "cd server && npm run test",
    "test:webapp": "cd webapp && npm run test",
    "test:coverage:all": "concurrently \"cd server && npx vitest --coverage run\" \"cd webapp && npx vitest --coverage run\"",
    "test:coverage:server": "cd server && npx vitest --coverage",
    "test:coverage:webapp": "cd webapp && npx vitest --coverage",
    "prisma_studio": "cd server && npm run prisma_studio --",
    "remove_merged": "git branch --merged | grep -Ev '(^\\*|main)' | xargs git branch -d && git fetch -p",
    "format:all": "npm run format:server && npm run format:webapp",
    "format:server": "cd server && npm run format",
    "format:webapp": "cd webapp && npm run format",
    "format:check:all": "npm run format:check:server && npm run format:check:webapp",
    "format:check:server": "cd server && npm run format:check",
    "format:check:webapp": "cd webapp && npm run format:check",
    "lint:all": "npm run lint:server && npm run lint:webapp",
    "lint:server": "cd server && npm run lint",
    "lint:webapp": "cd webapp && npm run lint",
    "typecheck:all": "npm run typecheck:server && npm run typecheck:webapp",
    "typecheck:server": "cd server && npm run typecheck",
    "typecheck:webapp": "cd webapp && npm run typecheck",
    "build:all": "npm run build:server && npm run build:webapp",
    "build:server": "cd server && npm run build",
    "build:webapp": "cd webapp && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goran1010/uniatlas-bosnia.git"
  },
  "keywords": [],
  "author": "Goran Jović",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/goran1010/uniatlas-bosnia/issues"
  },
  "homepage": "https://github.com/goran1010/uniatlas-bosnia#readme",
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
