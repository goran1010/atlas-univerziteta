# Domain name (used by Caddy for HTTPS and by the server for URLs)
DOMAIN=atlasuniverziteta.ba

# PostgreSQL credentials (used by both the db and server containers)
POSTGRES_USER=atlasuniverziteta
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=atlasuniverziteta

# Resend email service
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=noreply@atlasuniverziteta.ba

# Session cookie secret (generate with: openssl rand -base64 32)
COOKIE_SECRET=replace-with-cookie-secret

# GitHub OAuth
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
