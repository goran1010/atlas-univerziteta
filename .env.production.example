# All variables are required unless marked optional.

# API subdomain (used by Caddy for HTTPS and by the server for URLs)
DOMAIN=api.atlasuniverziteta.com

# Webapp domain (used by the server for CORS origin and redirects)
WEBAPP_DOMAIN=atlasuniverziteta.com

# PostgreSQL credentials (used by both the db and server containers)
POSTGRES_USER=atlasuniverziteta
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=atlasuniverziteta

# Resend email service (required in production, optional in development)
RESEND_API_KEY=replace-with-resend-api-key

# Optional - defaults to onboarding@resend.dev if unset
RESEND_FROM_EMAIL=noreply@atlasuniverziteta.com

# BetterAuth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-better-auth-secret

# GitHub OAuth
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
